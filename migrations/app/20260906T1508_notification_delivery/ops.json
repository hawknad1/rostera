        "sql": "CREATE TABLE \"public\".\"notificationDelivery\" (\n  \"attemptCount\" int4 DEFAULT 0 NOT NULL,\n  \"availableAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"channel\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"deliveredAt\" timestamptz,\n  \"destination\" text,\n  \"eventId\" text NOT NULL,\n  \"eventType\" text NOT NULL,\n  \"failedAt\" timestamptz,\n  \"id\" text NOT NULL,\n  \"lastError\" text,\n  \"notificationId\" text,\n  \"notificationOutboxId\" text NOT NULL,\n  \"organizationId\" text NOT NULL,\n  \"processingStartedAt\" timestamptz,\n  \"provider\" text NOT NULL,\n  \"providerMessageId\" text,\n  \"recipientUserId\" text NOT NULL,\n  \"sentAt\" timestamptz,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"templateKey\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"notificationDelivery_channel_check_90967890\" CHECK (\"channel\" IN ('IN_APP', 'EMAIL', 'SMS', 'WHATSAPP')),\n  CONSTRAINT \"notificationDelivery_eventType_check_485b977b\" CHECK (\"eventType\" IN ('LEAVE_REQUESTED', 'LEAVE_APPROVED', 'LEAVE_REJECTED', 'LEAVE_CANCELLED', 'SHIFT_SWAP_REQUESTED', 'SHIFT_SWAP_COMPLETED', 'SHIFT_SWAP_REJECTED', 'SHIFT_SWAP_CANCELLED', 'ROSTER_SUBMITTED_FOR_REVIEW', 'ROSTER_PUBLISHED', 'ROSTER_RETURNED_TO_DRAFT', 'ROSTER_AMENDMENT_CREATED')),\n  CONSTRAINT \"notificationDelivery_provider_check_fe2ede52\" CHECK (\"provider\" IN ('IN_APP', 'RESEND', 'TWILIO_SMS', 'TWILIO_WHATSAPP')),\n  CONSTRAINT \"notificationDelivery_status_check_1e8e023a\" CHECK (\"status\" IN ('PENDING', 'PROCESSING', 'SENT', 'DELIVERED', 'FAILED', 'CANCELLED'))\n)",
