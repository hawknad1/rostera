        "description": "create table \"leaveRequest\"",
        "sql": "CREATE TABLE \"public\".\"leaveRequest\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"endDate\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"leaveType\" text NOT NULL,\n  \"notes\" text,\n  \"organizationId\" text NOT NULL,\n  \"requestedByUserId\" text NOT NULL,\n  \"reviewedAt\" timestamptz,\n  \"reviewedByUserId\" text,\n  \"staffId\" text NOT NULL,\n  \"startDate\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"leaveRequest_date_order_2aa69aa6\" CHECK (\"startDate\" <= \"endDate\"),\n  CONSTRAINT \"leaveRequest_leaveType_check_8e9923c5\" CHECK (\"leaveType\" IN ('ANNUAL', 'SICK', 'MATERNITY', 'PATERNITY', 'STUDY', 'COMPASSIONATE', 'OTHER')),\n  CONSTRAINT \"leaveRequest_status_check_57fe5f48\" CHECK (\"status\" IN ('PENDING', 'APPROVED', 'REJECTED', 'CANCELLED'))\n)",
        "params": []
      }
    ],
