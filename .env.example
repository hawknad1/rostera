# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NEXT_PUBLIC_APP_NAME=Rostera
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for the notification drain worker. Fail-closed if unset.
# NOTIFICATION_WORKER_SECRET=

# Optional email (Resend). Leave unset to disable email delivery.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Rostera <notifications@example.com>

# Optional SMS / WhatsApp (Twilio). Leave unset to disable those channels.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=
# TWILIO_CONTENT_SID=

# Required in production if Twilio webhooks are used. Do not rely on request.url.
# TWILIO_STATUS_CALLBACK_URL=https://app.example.com/api/webhooks/twilio/status

# Optional local Playwright credentials. Never commit real passwords.
# E2E_BASE_URL=http://127.0.0.1:3100
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
