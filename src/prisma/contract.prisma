enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  LOCUM
  CASUAL
}

enum RosterStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  AMENDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  STUDY
  COMPASSIONATE
  OTHER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  region    String?
  country   String   @default("Ghana")
  timezone  String   @default("Africa/Accra")
  status    OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  members              OrganizationMember[]
  departments          Department[]
  professions          Profession[]
  staff                StaffProfile[]
  roles                Role[]
  shiftTypes           ShiftType[]
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]
  schedulingPolicy     OrganizationSchedulingPolicy?
  leaveRequests        LeaveRequest[]

  @@rls
}

model User {
  id             String   @id @default(uuid())
  authProviderId String   @unique

  email          String?
  phone          String?

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  memberships            OrganizationMember[]
  staffProfiles          StaffProfile[]
  createdRosters         Roster[]
  requestedLeaveRequests LeaveRequest[] @relation("LeaveRequestedBy")
  reviewedLeaveRequests  LeaveRequest[] @relation("LeaveReviewedBy")

  @@rls
}

model OrganizationMember {
  id             String   @id @default(uuid())

  organizationId String
  userId         String
  roleId         String

  status         MembershipStatus @default(INVITED)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@rls
}

model Role {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?

  roles       RolePermission[]

  @@rls
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@rls
}

model Department {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?

  headStaffId    String?  @unique

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[] @relation("DepartmentStaff")
  headStaff            StaffProfile?  @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model Profession {
  id             String   @id @default(uuid())

  organizationId String?
  name           String
  description    String?
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[]
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@index([organizationId])
  @@rls
}

model StaffProfile {
  id               String   @id @default(uuid())

  organizationId   String
  userId           String?

  staffNumber      String

  firstName        String
  middleName       String?
  lastName         String

  phone            String?
  email            String?

  professionId     String
  departmentId     String

  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType   @default(FULL_TIME)

  dateJoined       DateTime?
  photoUrl         String?

  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User? @relation(fields: [userId], references: [id])
  profession       Profession @relation(fields: [professionId], references: [id])
  department       Department @relation("DepartmentStaff", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHead")
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]

  @@unique([organizationId, staffNumber])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([professionId])
  @@rls
}

model ShiftType {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?
  startTime      String
  endTime        String
  isOvernight    Boolean
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model StaffingRequirement {
  id             String   @id @default(uuid())

  organizationId String
  departmentId   String
  shiftTypeId    String
  professionId   String
  requiredCount  Int

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])

  @@unique([organizationId, departmentId, shiftTypeId, professionId], map: "staffingRequirement_combo_key")
  @@index([organizationId])
  @@index([departmentId])
  @@rls
}

model Roster {
  id              String       @id @default(uuid())
  organizationId  String
  departmentId    String
  name            String
  startDate       String
  endDate         String
  status          RosterStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       temporal.updatedAt()

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department       @relation(fields: [departmentId], references: [id])
  createdBy    User             @relation(fields: [createdByUserId], references: [id])
  assignments  ShiftAssignment[]

  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, startDate, endDate])
  @@rls
}

model ShiftAssignment {
  id             String   @id @default(uuid())
  organizationId String
  rosterId       String
  departmentId   String
  staffId        String
  shiftTypeId    String
  professionId   String
  date           String
  shiftStartTime String
  shiftEndTime   String
  isOvernight    Boolean
  startDateTime  DateTime
  endDateTime    DateTime
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster       Roster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])

  @@unique([rosterId, staffId, shiftTypeId, date], map: "shiftAssignment_combo_key")
  @@check(expression: "\"startDateTime\" < \"endDateTime\"", name: "shiftAssignment_window_order")
  @@index([organizationId])
  @@index([rosterId])
  @@index([rosterId, date])
  @@index([staffId, date])
  @@index([shiftTypeId, date])
  @@rls
}

model OrganizationSchedulingPolicy {
  id                          String   @id @default(uuid())
  organizationId              String   @unique
  minimumRestMinutes          Int?
  maximumWeeklyMinutes        Int?
  maximumConsecutiveDays      Int?
  maximumNightShiftsPerWeek   Int?
  maximumWeekendShifts        Int?
  createdAt                   DateTime @default(now())
  updatedAt                   temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@rls
}

model LeaveRequest {
  id                String      @id @default(uuid())
  organizationId    String
  staffId           String
  leaveType         LeaveType
  startDate         String
  endDate           String
  status            LeaveStatus @default(PENDING)
  notes             String?
  requestedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  requestedBy  User         @relation("LeaveRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy   User?        @relation("LeaveReviewedBy", fields: [reviewedByUserId], references: [id])

  @@check(expression: "\"startDate\" <= \"endDate\"", name: "leaveRequest_date_order")
  @@index([organizationId])
  @@index([organizationId, staffId])
  @@index([organizationId, status])
  @@index([staffId, status, startDate, endDate])
  @@rls
}