enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  LOCUM
  CASUAL
}

enum RosterStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  AMENDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  STUDY
  COMPASSIONATE
  OTHER
}

enum ShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  SHIFT_SWAP_REQUESTED
  SHIFT_SWAP_COMPLETED
  SHIFT_SWAP_REJECTED
  SHIFT_SWAP_CANCELLED
  ROSTER_SUBMITTED_FOR_REVIEW
  ROSTER_PUBLISHED
  ROSTER_RETURNED_TO_DRAFT
  ROSTER_AMENDMENT_CREATED
}

enum NotificationEntityType {
  LEAVE_REQUEST
  SHIFT_SWAP
  ROSTER
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditAction {
  ROSTER_CREATED
  ROSTER_UPDATED
  ROSTER_SUBMITTED_FOR_REVIEW
  ROSTER_RETURNED_TO_DRAFT
  ROSTER_PUBLISHED
  ROSTER_AMENDMENT_CREATED
  ROSTER_DELETED
  ASSIGNMENT_CREATED
  ASSIGNMENT_DELETED
  LEAVE_CREATED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  SHIFT_SWAP_REQUESTED
  SHIFT_SWAP_COMPLETED
  SHIFT_SWAP_REJECTED
  SHIFT_SWAP_CANCELLED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_DEACTIVATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  DEPARTMENT_HEAD_ASSIGNED
  DEPARTMENT_HEAD_REMOVED
  PROFESSION_CREATED
  PROFESSION_UPDATED
  PROFESSION_DEACTIVATED
  SHIFT_TYPE_CREATED
  SHIFT_TYPE_UPDATED
  SHIFT_TYPE_DEACTIVATED
  STAFFING_REQUIREMENT_CREATED
  STAFFING_REQUIREMENT_UPDATED
  STAFFING_REQUIREMENT_DELETED
  SCHEDULING_POLICY_UPDATED
  USER_INVITED
  USER_UPDATED
  USER_DEACTIVATED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_ACTIVATED
  MEMBERSHIP_DEACTIVATED
}

enum AuditEntityType {
  ROSTER
  ASSIGNMENT
  LEAVE_REQUEST
  SHIFT_SWAP
  STAFF
  DEPARTMENT
  PROFESSION
  SHIFT_TYPE
  STAFFING_REQUIREMENT
  SCHEDULING_POLICY
  USER
  MEMBERSHIP
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  region    String?
  country   String   @default("Ghana")
  timezone  String   @default("Africa/Accra")
  status    OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  members              OrganizationMember[]
  departments          Department[]
  professions          Profession[]
  staff                StaffProfile[]
  roles                Role[]
  shiftTypes           ShiftType[]
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]
  schedulingPolicy     OrganizationSchedulingPolicy?
  leaveRequests        LeaveRequest[]
  shiftSwapRequests    ShiftSwapRequest[]
  notifications        Notification[]
  notificationOutbox   NotificationOutbox[]
  auditEvents          AuditEvent[]

  @@rls
}

model User {
  id             String   @id @default(uuid())
  authProviderId String   @unique

  email          String?
  phone          String?

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  memberships            OrganizationMember[]
  staffProfiles          StaffProfile[]
  createdRosters         Roster[]
  requestedLeaveRequests LeaveRequest[] @relation("LeaveRequestedBy")
  reviewedLeaveRequests  LeaveRequest[] @relation("LeaveReviewedBy")
  requestedShiftSwaps    ShiftSwapRequest[] @relation("ShiftSwapRequestedBy")
  reviewedShiftSwaps     ShiftSwapRequest[] @relation("ShiftSwapReviewedBy")
  notifications          Notification[]
  auditEvents            AuditEvent[]

  @@rls
}

model OrganizationMember {
  id             String   @id @default(uuid())

  organizationId String
  userId         String
  roleId         String

  status         MembershipStatus @default(INVITED)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  auditEvents    AuditEvent[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@rls
}

model Role {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?

  roles       RolePermission[]

  @@rls
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@rls
}

model Department {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?

  headStaffId    String?  @unique

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[] @relation("DepartmentStaff")
  headStaff            StaffProfile?  @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model Profession {
  id             String   @id @default(uuid())

  organizationId String?
  name           String
  description    String?
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[]
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@index([organizationId])
  @@rls
}

model StaffProfile {
  id               String   @id @default(uuid())

  organizationId   String
  userId           String?

  staffNumber      String

  firstName        String
  middleName       String?
  lastName         String

  phone            String?
  email            String?

  professionId     String
  departmentId     String

  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType   @default(FULL_TIME)

  dateJoined       DateTime?
  photoUrl         String?

  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User? @relation(fields: [userId], references: [id])
  profession       Profession @relation(fields: [professionId], references: [id])
  department       Department @relation("DepartmentStaff", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHead")
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]
  requestedSwaps   ShiftSwapRequest[] @relation("ShiftSwapRequesterStaff")
  targetedSwaps    ShiftSwapRequest[] @relation("ShiftSwapTargetStaff")

  @@unique([organizationId, staffNumber])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([professionId])
  @@rls
}

model ShiftType {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?
  startTime      String
  endTime        String
  isOvernight    Boolean
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model StaffingRequirement {
  id             String   @id @default(uuid())

  organizationId String
  departmentId   String
  shiftTypeId    String
  professionId   String
  requiredCount  Int

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])

  @@unique([organizationId, departmentId, shiftTypeId, professionId], map: "staffingRequirement_combo_key")
  @@index([organizationId])
  @@index([departmentId])
  @@rls
}

model Roster {
  id               String       @id @default(uuid())
  organizationId   String
  departmentId     String
  name             String
  startDate        String
  endDate          String
  status           RosterStatus @default(DRAFT)
  seriesId         String       @default(uuid())
  versionNumber    Int          @default(1)
  parentRosterId   String?
  amendmentReason  String?
  createdByUserId  String
  createdAt        DateTime     @default(now())
  updatedAt        temporal.updatedAt()

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department        @relation(fields: [departmentId], references: [id])
  createdBy    User              @relation(fields: [createdByUserId], references: [id])
  parentRoster Roster?           @relation("RosterVersionParent", fields: [parentRosterId], references: [id])
  childVersions Roster[]         @relation("RosterVersionParent")
  assignments  ShiftAssignment[]
  shiftSwaps   ShiftSwapRequest[]

  @@unique([organizationId, seriesId, versionNumber], map: "roster_series_version_key")
  @@check(expression: "\"versionNumber\" >= 1", name: "roster_version_number")
  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, seriesId])
  @@index([parentRosterId])
  @@rls
}

model ShiftAssignment {
  id                      String   @id @default(uuid())
  organizationId          String
  rosterId                String
  departmentId            String
  staffId                 String
  shiftTypeId             String
  professionId            String
  date                    String
  shiftStartTime          String
  shiftEndTime            String
  isOvernight             Boolean
  startDateTime           DateTime
  endDateTime             DateTime
  copiedFromAssignmentId  String?
  createdAt               DateTime @default(now())
  updatedAt               temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster       Roster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])
  sourceSwaps  ShiftSwapRequest[] @relation("ShiftSwapSourceAssignment")
  targetSwaps  ShiftSwapRequest[] @relation("ShiftSwapTargetAssignment")

  @@unique([rosterId, staffId, shiftTypeId, date], map: "shiftAssignment_combo_key")
  @@check(expression: "\"startDateTime\" < \"endDateTime\"", name: "shiftAssignment_window_order")
  @@index([organizationId])
  @@index([rosterId])
  @@index([rosterId, date])
  @@index([staffId, date])
  @@index([shiftTypeId, date])
  @@index([copiedFromAssignmentId])
  @@rls
}

model OrganizationSchedulingPolicy {
  id                          String   @id @default(uuid())
  organizationId              String   @unique
  minimumRestMinutes          Int?
  maximumWeeklyMinutes        Int?
  maximumConsecutiveDays      Int?
  maximumNightShiftsPerWeek   Int?
  maximumWeekendShifts        Int?
  createdAt                   DateTime @default(now())
  updatedAt                   temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@rls
}

model LeaveRequest {
  id                String      @id @default(uuid())
  organizationId    String
  staffId           String
  leaveType         LeaveType
  startDate         String
  endDate           String
  status            LeaveStatus @default(PENDING)
  notes             String?
  requestedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  requestedBy  User         @relation("LeaveRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy   User?        @relation("LeaveReviewedBy", fields: [reviewedByUserId], references: [id])

  @@check(expression: "\"startDate\" <= \"endDate\"", name: "leaveRequest_date_order")
  @@index([organizationId])
  @@index([organizationId, staffId])
  @@index([organizationId, status])
  @@index([staffId, status, startDate, endDate])
  @@rls
}

model ShiftSwapRequest {
  id                  String          @id @default(uuid())
  organizationId      String
  rosterId            String
  departmentId        String
  sourceAssignmentId  String
  targetAssignmentId  String
  requesterStaffId    String
  targetStaffId       String
  status              ShiftSwapStatus @default(PENDING)
  reason              String?
  reviewNotes         String?
  requestedByUserId   String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           temporal.updatedAt()

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster           Roster          @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  sourceAssignment ShiftAssignment @relation("ShiftSwapSourceAssignment", fields: [sourceAssignmentId], references: [id])
  targetAssignment ShiftAssignment @relation("ShiftSwapTargetAssignment", fields: [targetAssignmentId], references: [id])
  requesterStaff   StaffProfile    @relation("ShiftSwapRequesterStaff", fields: [requesterStaffId], references: [id])
  targetStaff      StaffProfile    @relation("ShiftSwapTargetStaff", fields: [targetStaffId], references: [id])
  requestedBy      User            @relation("ShiftSwapRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy       User?           @relation("ShiftSwapReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([rosterId])
  @@index([sourceAssignmentId])
  @@index([targetAssignmentId])
  @@index([requesterStaffId])
  @@index([targetStaffId])
  @@rls
}

model Notification {
  id              String                   @id @default(uuid())
  organizationId  String
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  entityType      NotificationEntityType?
  entityId        String?
  eventId         String
  readAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recipientUserId, type, eventId], map: "notification_idempotency_key")
  @@index([organizationId, recipientUserId, createdAt], map: "notification_inbox_created_idx")
  @@index([organizationId, recipientUserId, readAt], map: "notification_inbox_read_idx")
  @@rls
}

model NotificationOutbox {
  id             String                     @id @default(uuid())
  organizationId String
  eventType      NotificationType
  eventId        String
  payload        String
  status         NotificationOutboxStatus   @default(PENDING)
  attempts       Int                        @default(0)
  availableAt    DateTime                   @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime                   @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventType, eventId], map: "notificationOutbox_event_key")
  @@index([organizationId, status, availableAt], map: "notificationOutbox_pickup_idx")
  @@rls
}

model AuditEvent {
  id                 String          @id @default(uuid())
  organizationId     String
  actorType          AuditActorType
  actorUserId        String?
  actorMembershipId  String?
  action             AuditAction
  entityType         AuditEntityType
  entityId           String
  eventId            String
  summary            String
  metadata           String?
  requestId          String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime        @default(now())

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser       User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership OrganizationMember? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, eventId], map: "auditEvent_event_key")
  @@index([organizationId, createdAt], map: "auditEvent_org_created_idx")
  @@index([organizationId, action, createdAt], map: "auditEvent_org_action_idx")
  @@index([organizationId, entityType, entityId, createdAt], map: "auditEvent_org_entity_idx")
  @@index([organizationId, actorUserId, createdAt], map: "auditEvent_org_actor_idx")
  @@rls
}