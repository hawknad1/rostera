model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  region    String?
  country   String   @default("Ghana")
  timezone  String   @default("Africa/Accra")
  status    OrganizationStatus @default(ACTIVE)
  organizationType OrganizationType @default(HOSPITAL)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  members              OrganizationMember[]
  departments          Department[]
  professions          Profession[]
  staff                StaffProfile[]
  roles                Role[]
  invitations          OrganizationInvitation[]
  shiftTypes           ShiftType[]
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]
  schedulingPolicy     OrganizationSchedulingPolicy?
  leaveRequests        LeaveRequest[]
  shiftSwapRequests    ShiftSwapRequest[]
  notifications                 Notification[]
  notificationOutbox            NotificationOutbox[]
  notificationDeliveries        NotificationDelivery[]
  notificationPreferences       NotificationPreference[]
  notificationDeliveryReceipts  NotificationDeliveryReceipt[]
  auditEvents                   AuditEvent[]
  attendancePolicy              OrganizationAttendancePolicy?
  attendanceRecords             AttendanceRecord[]
  attendanceEvents              AttendanceEvent[]
  attendanceExceptions          AttendanceException[]

  @@rls
}

model User {
  id             String   @id @default(uuid())
  authProviderId String   @unique

  email          String?
  phone          String?
  displayName    String?

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  memberships            OrganizationMember[]
  staffProfiles          StaffProfile[]
  createdRosters         Roster[]
  requestedLeaveRequests LeaveRequest[] @relation("LeaveRequestedBy")
  reviewedLeaveRequests  LeaveRequest[] @relation("LeaveReviewedBy")
  requestedShiftSwaps    ShiftSwapRequest[] @relation("ShiftSwapRequestedBy")
  reviewedShiftSwaps     ShiftSwapRequest[] @relation("ShiftSwapReviewedBy")
  notifications            Notification[]
  notificationDeliveries   NotificationDelivery[]
  notificationPreferences  NotificationPreference[]
  auditEvents              AuditEvent[]
  approvedAttendance       AttendanceRecord[] @relation("AttendanceApprovedBy")
  attendanceEvents         AttendanceEvent[] @relation("AttendanceEventActor")
  resolvedExceptions       AttendanceException[] @relation("AttendanceExceptionResolvedBy")
  sentInvitations          OrganizationInvitation[] @relation("InvitationInvitedBy")
  acceptedInvitations      OrganizationInvitation[] @relation("InvitationAcceptedBy")

  @@rls
}

model OrganizationMember {
  id             String   @id @default(uuid())

  organizationId String
  userId         String
  roleId         String

  status         MembershipStatus @default(INVITED)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  auditEvents    AuditEvent[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@rls
}

model Role {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  permissions    RolePermission[]
  invitations    OrganizationInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model OrganizationInvitation {
  id               String   @id @default(uuid())

  organizationId   String
  email            String
  roleId           String
  tokenHash        String   @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedAt       DateTime?
  acceptedByUserId String?

  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role         @relation(fields: [roleId], references: [id])
  invitedBy        User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy       User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, email, status])
  @@rls
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?

  roles       RolePermission[]

  @@rls
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@rls
}

model Department {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?

  headStaffId    String?  @unique

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[] @relation("DepartmentStaff")
  headStaff            StaffProfile?  @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staffingRequirements StaffingRequirement[]
  rosters              Roster[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model Profession {
  id             String   @id @default(uuid())

  organizationId String?
  name           String
  description    String?
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                StaffProfile[]
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@index([organizationId])
  @@rls
}

model StaffProfile {
  id               String   @id @default(uuid())

  organizationId   String
  userId           String?

  staffNumber      String

  firstName        String
  middleName       String?
  lastName         String

  phone            String?
  email            String?

  professionId     String
  departmentId     String

  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType   @default(FULL_TIME)

  dateJoined       DateTime?
  photoUrl         String?

  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User? @relation(fields: [userId], references: [id])
  profession       Profession @relation(fields: [professionId], references: [id])
  department       Department @relation("DepartmentStaff", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHead")
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]
  requestedSwaps   ShiftSwapRequest[] @relation("ShiftSwapRequesterStaff")
  targetedSwaps    ShiftSwapRequest[] @relation("ShiftSwapTargetStaff")
  attendanceRecords AttendanceRecord[]
  attendanceEvents  AttendanceEvent[]
  attendanceExceptions AttendanceException[]

  @@unique([organizationId, staffNumber])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([professionId])
  @@rls
}

model ShiftType {
  id             String   @id @default(uuid())

  organizationId String
  name           String
  description    String?
  startTime      String
  endTime        String
  isOvernight    Boolean
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@rls
}

model StaffingRequirement {
  id             String   @id @default(uuid())

  organizationId String
  departmentId   String
  shiftTypeId    String
  professionId   String
  requiredCount  Int

  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])

  @@unique([organizationId, departmentId, shiftTypeId, professionId], map: "staffingRequirement_combo_key")
  @@index([organizationId])
  @@index([departmentId])
  @@rls
}

model Roster {
  id               String       @id @default(uuid())
  organizationId   String
  departmentId     String
  name             String
  startDate        String
  endDate          String
  status           RosterStatus @default(DRAFT)
  seriesId         String       @default(uuid())
  versionNumber    Int          @default(1)
  parentRosterId   String?
  amendmentReason  String?
  createdByUserId  String
  createdAt        DateTime     @default(now())
  updatedAt        temporal.updatedAt()

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department        @relation(fields: [departmentId], references: [id])
  createdBy    User              @relation(fields: [createdByUserId], references: [id])
  parentRoster Roster?           @relation("RosterVersionParent", fields: [parentRosterId], references: [id])
  childVersions Roster[]         @relation("RosterVersionParent")
  assignments  ShiftAssignment[]
  shiftSwaps   ShiftSwapRequest[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, seriesId, versionNumber], map: "roster_series_version_key")
  @@check(expression: "\"versionNumber\" >= 1", name: "roster_version_number")
  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, seriesId])
  @@index([parentRosterId])
  @@rls
}

model ShiftAssignment {
  id                      String   @id @default(uuid())
  organizationId          String
  rosterId                String
  departmentId            String
  staffId                 String
  shiftTypeId             String
  professionId            String
  date                    String
  shiftStartTime          String
  shiftEndTime            String
  isOvernight             Boolean
  startDateTime           DateTime
  endDateTime             DateTime
  copiedFromAssignmentId  String?
  createdAt               DateTime @default(now())
  updatedAt               temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster       Roster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])
  profession   Profession   @relation(fields: [professionId], references: [id])
  sourceSwaps  ShiftSwapRequest[] @relation("ShiftSwapSourceAssignment")
  targetSwaps  ShiftSwapRequest[] @relation("ShiftSwapTargetAssignment")
  attendanceRecords AttendanceRecord[]

  @@unique([rosterId, staffId, shiftTypeId, date], map: "shiftAssignment_combo_key")
  @@check(expression: "\"startDateTime\" < \"endDateTime\"", name: "shiftAssignment_window_order")
  @@index([organizationId])
  @@index([rosterId])
  @@index([rosterId, date])
  @@index([staffId, date])
  @@index([shiftTypeId, date])
  @@index([copiedFromAssignmentId])
  @@rls
}

model OrganizationSchedulingPolicy {
  id                          String   @id @default(uuid())
  organizationId              String   @unique
  minimumRestMinutes          Int?
  maximumWeeklyMinutes        Int?
  maximumConsecutiveDays      Int?
  maximumNightShiftsPerWeek   Int?
  maximumWeekendShifts        Int?
  createdAt                   DateTime @default(now())
  updatedAt                   temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@rls
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  MISSED
  EXCEPTION
  CORRECTED
  VOIDED
}

enum AttendanceReviewStatus {
  UNREVIEWED
  APPROVED
  REJECTED
}

enum AttendanceSource {
  STAFF_PWA
  ADMIN
  SYSTEM
  DEVICE
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  MANUAL_CLOCK_IN
  MANUAL_CLOCK_OUT
  CORRECTION
  VOID
}

enum AttendanceExceptionType {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  MISSED_CLOCK_IN
  MISSED_CLOCK_OUT
  UNSCHEDULED_ATTENDANCE
  OVERTIME
  OUTSIDE_SCHEDULE
}

enum AttendanceExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED
}

enum AttendanceExceptionSeverity {
  INFO
  WARNING
}

model OrganizationAttendancePolicy {
  id                             String   @id @default(uuid())
  organizationId                 String   @unique
  attendanceEnabled              Boolean  @default(true)
  lateThresholdMinutes           Int      @default(0)
  earlyDepartureThresholdMinutes Int      @default(0)
  overtimeThresholdMinutes       Int      @default(0)
  allowUnscheduledAttendance     Boolean  @default(true)
  allowEarlyClockIn              Boolean  @default(true)
  maximumEarlyClockInMinutes     Int      @default(120)
  maximumLateClockOutMinutes     Int      @default(720)
  createdAt                      DateTime @default(now())
  updatedAt                      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@check(expression: "\"lateThresholdMinutes\" >= 0", name: "attendancePolicy_late_threshold")
  @@check(expression: "\"earlyDepartureThresholdMinutes\" >= 0", name: "attendancePolicy_early_threshold")
  @@check(expression: "\"overtimeThresholdMinutes\" >= 0", name: "attendancePolicy_overtime_threshold")
  @@check(expression: "\"maximumEarlyClockInMinutes\" >= 0", name: "attendancePolicy_early_clock_in")
  @@check(expression: "\"maximumLateClockOutMinutes\" >= 0", name: "attendancePolicy_late_clock_out")
  @@rls
}

model AttendanceRecord {
  id                       String                  @id @default(uuid())
  organizationId           String
  staffId                  String
  rosterId                 String?
  assignmentId             String?
  attendanceDate           String
  scheduledStartDateTime   DateTime?
  scheduledEndDateTime     DateTime?
  actualClockInDateTime    DateTime?
  actualClockOutDateTime   DateTime?
  scheduledMinutes         Int?
  actualMinutes            Int?
  lateMinutes              Int                     @default(0)
  earlyDepartureMinutes    Int                     @default(0)
  overtimeMinutes          Int                     @default(0)
  status                   AttendanceStatus
  reviewStatus             AttendanceReviewStatus  @default(UNREVIEWED)
  source                   AttendanceSource
  openSessionKey           String?
  notes                    String?
  approvedByUserId         String?
  approvedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                temporal.updatedAt()

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffProfile     @relation(fields: [staffId], references: [id])
  roster       Roster?          @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  assignment   ShiftAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  approvedBy   User?            @relation("AttendanceApprovedBy", fields: [approvedByUserId], references: [id])
  events       AttendanceEvent[]
  exceptions   AttendanceException[]

  @@unique([organizationId, staffId, openSessionKey], map: "attendanceRecord_open_session_key")
  @@check(expression: "\"lateMinutes\" >= 0 AND \"earlyDepartureMinutes\" >= 0 AND \"overtimeMinutes\" >= 0", name: "attendanceRecord_minutes_non_negative")
  @@check(expression: "\"actualClockOutDateTime\" IS NULL OR \"actualClockInDateTime\" IS NULL OR \"actualClockInDateTime\" < \"actualClockOutDateTime\"", name: "attendanceRecord_clock_order")
  @@check(expression: "(\"status\" = 'OPEN' AND \"openSessionKey\" = 'OPEN') OR (\"status\" <> 'OPEN' AND \"openSessionKey\" IS NULL)", name: "attendanceRecord_open_session_state")
  @@index([organizationId], map: "attendanceRecord_org_idx")
  @@index([organizationId, attendanceDate], map: "attendanceRecord_org_date_idx")
  @@index([organizationId, staffId, attendanceDate], map: "attendanceRecord_org_staff_date_idx")
  @@index([organizationId, status], map: "attendanceRecord_org_status_idx")
  @@index([assignmentId], map: "attendanceRecord_assignment_idx")
  @@index([rosterId], map: "attendanceRecord_roster_idx")
  @@rls
}

model AttendanceEvent {
  id                  String              @id @default(uuid())
  organizationId      String
  attendanceRecordId  String
  staffId             String
  type                AttendanceEventType
  occurredAt          DateTime
  source              AttendanceSource
  actorUserId         String?
  punchKey            String?
  metadata            String?
  createdAt           DateTime            @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  record       AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  staff        StaffProfile     @relation(fields: [staffId], references: [id])
  actor        User?            @relation("AttendanceEventActor", fields: [actorUserId], references: [id])

  @@unique([attendanceRecordId, punchKey], map: "attendanceEvent_punch_key")
  @@check(expression: "(\"type\" IN ('CLOCK_IN', 'CLOCK_OUT', 'VOID') AND \"punchKey\" = \"type\") OR (\"type\" NOT IN ('CLOCK_IN', 'CLOCK_OUT', 'VOID') AND \"punchKey\" IS NULL)", name: "attendanceEvent_punch_key_state")
  @@index([organizationId], map: "attendanceEvent_org_idx")
  @@index([attendanceRecordId], map: "attendanceEvent_record_idx")
  @@index([organizationId, staffId], map: "attendanceEvent_org_staff_idx")
  @@rls
}

model AttendanceException {
  id                  String                       @id @default(uuid())
  organizationId      String
  attendanceRecordId  String
  staffId             String
  type                AttendanceExceptionType
  severity            AttendanceExceptionSeverity
  status              AttendanceExceptionStatus    @default(OPEN)
  detectedAt          DateTime
  resolvedAt          DateTime?
  resolvedByUserId    String?
  notes               String?
  metadata            String?
  createdAt           DateTime                     @default(now())
  updatedAt           temporal.updatedAt()

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  record       AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  staff        StaffProfile     @relation(fields: [staffId], references: [id])
  resolvedBy   User?            @relation("AttendanceExceptionResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([organizationId], map: "attendanceException_org_idx")
  @@index([attendanceRecordId], map: "attendanceException_record_idx")
  @@index([organizationId, staffId], map: "attendanceException_org_staff_idx")
  @@index([organizationId, status], map: "attendanceException_org_status_idx")
  @@index([organizationId, type], map: "attendanceException_org_type_idx")
  @@rls
}

model LeaveRequest {
  id                String      @id @default(uuid())
  organizationId    String
  staffId           String
  leaveType         LeaveType
  startDate         String
  endDate           String
  status            LeaveStatus @default(PENDING)
  notes             String?
  requestedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  requestedBy  User         @relation("LeaveRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy   User?        @relation("LeaveReviewedBy", fields: [reviewedByUserId], references: [id])

  @@check(expression: "\"startDate\" <= \"endDate\"", name: "leaveRequest_date_order")
  @@index([organizationId])
  @@index([organizationId, staffId])
  @@index([organizationId, status])
  @@index([staffId, status, startDate, endDate])
  @@rls
}

model ShiftSwapRequest {
  id                  String          @id @default(uuid())
  organizationId      String
  rosterId            String
  departmentId        String
  sourceAssignmentId  String
  targetAssignmentId  String
  requesterStaffId    String
  targetStaffId       String
  status              ShiftSwapStatus @default(PENDING)
  reason              String?
  reviewNotes         String?
  requestedByUserId   String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           temporal.updatedAt()

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roster           Roster          @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  sourceAssignment ShiftAssignment @relation("ShiftSwapSourceAssignment", fields: [sourceAssignmentId], references: [id])
  targetAssignment ShiftAssignment @relation("ShiftSwapTargetAssignment", fields: [targetAssignmentId], references: [id])
  requesterStaff   StaffProfile    @relation("ShiftSwapRequesterStaff", fields: [requesterStaffId], references: [id])
  targetStaff      StaffProfile    @relation("ShiftSwapTargetStaff", fields: [targetStaffId], references: [id])
  requestedBy      User            @relation("ShiftSwapRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy       User?           @relation("ShiftSwapReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([rosterId])
  @@index([sourceAssignmentId])
  @@index([targetAssignmentId])
  @@index([requesterStaffId])
  @@index([targetStaffId])
  @@rls
}

model Notification {
  id              String                   @id @default(uuid())
  organizationId  String
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  entityType      NotificationEntityType?
  entityId        String?
  eventId         String
  readAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([organizationId, recipientUserId, type, eventId], map: "notification_idempotency_key")
  @@index([organizationId, recipientUserId, createdAt], map: "notification_inbox_created_idx")
  @@index([organizationId, recipientUserId, readAt], map: "notification_inbox_read_idx")
  @@rls
}

model NotificationOutbox {
  id             String                     @id @default(uuid())
  organizationId String
  eventType      NotificationType
  eventId        String
  payload        String
  status         NotificationOutboxStatus   @default(PENDING)
  attempts       Int                        @default(0)
  availableAt           DateTime                   @default(now())
  processingStartedAt   DateTime?
  processedAt           DateTime?
  lastError             String?
  createdAt             DateTime                   @default(now())
  updatedAt             temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([organizationId, eventType, eventId], map: "notificationOutbox_event_key")
  @@index([organizationId, status, availableAt], map: "notificationOutbox_pickup_idx")
  @@rls
}

model NotificationDelivery {
  id                    String                         @id @default(uuid())
  organizationId        String
  notificationOutboxId  String
  notificationId        String?
  recipientUserId       String
  eventType             NotificationType
  eventId               String
  channel               NotificationChannel
  provider              NotificationDeliveryProvider
  status                NotificationDeliveryStatus     @default(PENDING)
  destination           String?
  templateKey           String
  attemptCount          Int                            @default(0)
  availableAt           DateTime                       @default(now())
  processingStartedAt   DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  lastError             String?
  providerMessageId     String?
  createdAt             DateTime                       @default(now())
  updatedAt             temporal.updatedAt()

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outbox       NotificationOutbox  @relation(fields: [notificationOutboxId], references: [id], onDelete: Cascade)
  notification Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipient    User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  receipts     NotificationDeliveryReceipt[]

  @@unique([organizationId, eventType, eventId, recipientUserId, channel], map: "notificationDelivery_idempotency_key")
  @@index([organizationId, status, availableAt], map: "notificationDelivery_pickup_idx")
  @@index([organizationId, providerMessageId], map: "notificationDelivery_provider_message_idx")
  @@index([notificationOutboxId])
  @@index([recipientUserId])
  @@rls
}

model NotificationPreference {
  id             String               @id @default(uuid())
  organizationId String
  userId         String
  eventType      NotificationType
  channel        NotificationChannel
  enabled        Boolean
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, eventType, channel], map: "notificationPreference_key")
  @@index([organizationId, userId], map: "notificationPreference_user_idx")
  @@rls
}

model NotificationDeliveryReceipt {
  id              String                         @id @default(uuid())
  organizationId  String
  deliveryId      String
  provider        NotificationDeliveryProvider
  providerEventId String
  status          String
  createdAt       DateTime                       @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delivery     NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, providerEventId], map: "notificationDeliveryReceipt_event_key")
  @@index([deliveryId])
  @@rls
}

model AuditEvent {
  id                 String          @id @default(uuid())
  organizationId     String
  actorType          AuditActorType
  actorUserId        String?
  actorMembershipId  String?
  action             AuditAction
  entityType         AuditEntityType
  entityId           String
  eventId            String
  summary            String
  metadata           String?
  requestId          String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime        @default(now())

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser       User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership OrganizationMember? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, eventId], map: "auditEvent_event_key")
  @@index([organizationId, createdAt], map: "auditEvent_org_created_idx")
  @@index([organizationId, action, createdAt], map: "auditEvent_org_action_idx")
  @@index([organizationId, entityType, entityId, createdAt], map: "auditEvent_org_entity_idx")
  @@index([organizationId, actorUserId, createdAt], map: "auditEvent_org_actor_idx")
  @@rls
}